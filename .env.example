# Local synthetic demo only. Docker Compose reads this after copying it to .env.
SECRET_KEY=local-demo-django-secret-change-before-sharing
DEMO_PASSWORD=local-demo-password-2026
EXECUTION_SECRET=local-demo-execution-secret
EXECUTION_SERVICE_KEY=local-demo-service-key
CLOUDBOX_API_KEY=cloudbox-dev-key
SHOPX_API_KEY=shopx-dev-key
CLOUDBOX_WIDGET_SECRET=cloudbox-widget-dev-secret
SHOPX_WIDGET_SECRET=shopx-widget-dev-secret

# Explicitly mocked AI by default. Live mode uses the currently implemented DeepSeek adapter.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=20
LLM_TOTAL_DEADLINE_SEC=30
LLM_MAX_CALLS_PER_MESSAGE=8
LLM_MAX_OUTPUT_TOKENS=1500
