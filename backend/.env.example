SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Optional; SQLite remains the template default. Install requirements-postgres.txt first.
# DATABASE_URL=postgres://cloud_support:local-password@localhost:5432/cloud_support
# Local synthetic accounts only; seed_demo requires DEBUG=True and >=12 characters.
# DEMO_PASSWORD=choose-a-local-demo-password

# LLM (DeepSeek is OpenAI-compatible). Keep the key only in your local .env, never in git.
# LLM_PROVIDER is deepseek or mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=20
LLM_MAX_CALLS_PER_MESSAGE=6
LLM_MAX_OUTPUT_TOKENS=800

# External product through the execution server (see execution/README.md). dev | mcp
ORCHESTRATOR_GATEWAY=dev
EXECUTION_URL=http://127.0.0.1:9000
EXECUTION_TENANT=cloudbox
EXECUTION_SECRET=
EXECUTION_SERVICE_KEY=
# EXECUTION_CUSTOMERS=paid_plus=c-101,active_pro=c-102,refund_review=c-103
