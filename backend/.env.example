SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Optional; SQLite remains the template default. Install requirements-postgres.txt first.
# DATABASE_URL=postgres://cloud_support:local-password@localhost:5432/cloud_support
# Local synthetic accounts only; seed_demo requires DEBUG=True and >=12 characters.
DEMO_PASSWORD=support-demo-2026

# LLM (DeepSeek is OpenAI-compatible). Keep the key only in your local .env, never in git.
# LLM_PROVIDER is deepseek or mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=20
LLM_TOTAL_DEADLINE_SEC=30
LLM_MAX_CALLS_PER_MESSAGE=8
LLM_MAX_OUTPUT_TOKENS=1500

# External product through the execution server (see execution/README.md). dev | mcp
ORCHESTRATOR_GATEWAY=mcp
EXECUTION_URL=http://127.0.0.1:9000
EXECUTION_TENANT=cloudbox
EXECUTION_SECRET=cloud-support-execution-dev-secret
EXECUTION_SERVICE_KEY=cloud-support-execution-service-dev-key
# Local mock product credentials. Use real secret storage outside development.
CLOUDBOX_API_KEY=cloudbox-dev-key
SHOPX_API_KEY=shopx-dev-key
# EXECUTION_CUSTOMERS=paid_plus=c-101,active_pro=c-102,refund_review=c-103

# Embeddable widget: per-product secrets that sign customer tokens (the mocks' dev defaults).
WIDGET_SECRETS=cloudbox=cloudbox-widget-dev-secret,shopx=shopx-widget-dev-secret
